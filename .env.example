# Lokal portaladresse. Brug den offentlige HTTPS-origin i drift.
DGITA_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Må kun være true i et lokalt testmiljø.
DGITA_ENABLE_DEV_LOGIN=true

# Mindst 32 tilfældige tegn i drift. Brug en platform-secret, ikke Git.
DGITA_APPROVAL_TOKEN_SECRET=replace-with-a-random-production-secret-of-at-least-32-characters

# Microsoft Graph / Outlook (server-side application permissions).
# Fjern # og indsæt rigtige værdier, når kommunens Entra-app er klar.
# DGITA_GRAPH_TENANT_ID=11111111-2222-3333-4444-555555555555
# DGITA_GRAPH_CLIENT_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# DGITA_GRAPH_CLIENT_SECRET=replace-with-an-entra-app-secret
# DGITA_GRAPH_SENDER=dgita@kommune.dk

# Valgfrie Graph-overrides.
# DGITA_GRAPH_AUTHORITY_HOST=https://login.microsoftonline.com
# DGITA_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# DGITA_GRAPH_SCOPE=https://graph.microsoft.com/.default
# DGITA_GRAPH_TIMEOUT_MS=10000

# Reserveret konfiguration til kommende OIDC-loginflows.
# Der er endnu ikke implementeret redirect/callback og claim-mapping.
# DGITA_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# DGITA_ENTRA_CLIENT_ID=<client-id>
# DGITA_ENTRA_REDIRECT_URI=https://portal.example.dk/api/auth/entra/callback
# DGITA_FK_ISSUER=https://<fk-issuer>/
# DGITA_FK_CLIENT_ID=<client-id>
# DGITA_FK_REDIRECT_URI=https://portal.example.dk/api/auth/fk/callback

# E2E-test bruger ellers http://localhost:3001.
# DGITA_E2E_BASE_URL=http://localhost:3001
